{
  "name": "goalie",
  "private": true,
  "description": "Goalie: the web app (served as-is from GitHub Pages) and its iPhone app (Capacitor, in ios/).",
  "scripts": {
    "build:firebase": "esbuild tools/firebase-entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=vendor/firebase.js",
    "build": "node tools/build-www.js",
    "ios": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/status-bar": "8.0.4",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2"
  }
}
